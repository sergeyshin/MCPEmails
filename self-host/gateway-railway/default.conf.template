server {
    listen 8080;
    server_name _;
    server_tokens off;

    location /rest/v1/ {
        proxy_pass http://${POSTGREST_HOST}:3000/;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
